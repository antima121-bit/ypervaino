# Optional — higher HF Hub rate limits for model download
# HF_TOKEN=

# Logging (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO

# LLM (do not commit — gitignored)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# BotProbe trace API (full event logs)
BOTPROBE_TRACE_BASE_URL=http://10.128.0.34:3333
BOTPROBE_TRACE_ENV=prod
BOTPROBE_BASE_URL=http://10.128.0.34:3333

# VA Blueprint (production bot service)
BOT_API_BASE_URL=https://bot.thelevel.ai
PRODUCTION_SERVICE_TOKEN=

# OpenAI embeddings (uses OPENAI_API_KEY above)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536
OPENAI_EMBEDDING_BATCH_SIZE=64

# Studies persisted here
STUDIES_ROOT=./studies

# Cap sessions traced per cohort (safety; raise for large eval)
MAX_TRACE_SESSIONS=200

# Parallel workers (trace fetch, digests, evaluation, intent scoring)
WORKER_THREADS=10

# Bot repo for ChangeContextResolver (git clone cache)
BOT_REPO_URL=git@gitlab.com:the-level-engineering/bot.git
BOT_REPO_DEFAULT_BRANCH=development
# Optional for private GitLab MR metadata API
# GITLAB_TOKEN=

PORT=8765
